/* Surfaces and controls shared by the simulator and its dialogs. */
QMainWindow, QDialog {
    background: #101821;
}
QWidget {
    color: #e8eef4;
}
QWidget#appHeader {
    background: #151f29;
    border-bottom: 1px solid #415264;
}
QWidget#graphSummary, QWidget#graphLegend, QGroupBox#groupEdit {
    background: #17222e;
    border: 1px solid #2b3a49;
    border-radius: 3px;
}
QWidget#graphSummary {
    border-left: 3px solid #ffd166;
}
QWidget#manualSummary {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #212d37, stop:1 #19242f);
    border-left: 2px solid #ffd166;
    border-bottom: 1px solid #354452;
}
QGroupBox#groupSim {
    border: 0;
}
QWidget#sidePanel {
    background: #17222e;
    border: 1px solid #2b3a49;
    border-radius: 3px;
}
QLabel#lblProduct, QLabel#lblGraphTitle, QLabel#lblTelemetry, QLabel#lblDialogTitle {
    color: #f4f7fa;
    font-family: "Bahnschrift", "Segoe UI";
    font-weight: 600;
}
QLabel#lblProduct {
    font-size: 23px;
}
QLabel#lblGraphTitle, QLabel#lblTelemetry, QLabel#lblDialogTitle {
    font-size: 18px;
}
QLabel#lblGraphCounts, QLabel#lblGraphClock, QLabel#lblManualIncome {
    font-family: "Consolas", monospace;
}
QLabel#lblGraphClock {
    font-size: 19px;
    font-weight: 700;
}
QLabel#lblManualIncome {
    font-size: 17px;
    font-weight: 700;
    color: #ffd166;
}
QLabel#lblManualTitle, QLabel#lblNodeFocus {
    color: #f0d6a1;
    font-weight: 600;
}
QLabel#lblGraphCounts, QLabel#lblGraphPeriod, QLabel#lblManualTrips, QLabel#lblManualState,
QLabel#lblNodeKey, QLabel#lblOneWayKey, QLabel#lblTwoWayKey {
    color: #a5b4c3;
    font-size: 12px;
}
QLabel#lblBfs, QLabel#lblDfs, QLabel#lblDijkstra {
    background: #1e2b36;
    border-left: 2px solid #8cd7ee;
    padding: 5px 8px;
    font-size: 12px;
}
QLabel#lblDfs { border-left-color: #ff79a6; }
QLabel#lblDijkstra { border-left-color: #81e1a1; }
QLabel#lblEditHint, QLabel#lblMapMode, QLabel#lblSpeed, QLabel#lblTimeMode {
    color: #a5b4c3;
}
QLabel#lblEditHint {
    font-size: 12px;
}
QPushButton, QComboBox, QLineEdit {
    background: #202e3d;
    border: 1px solid #35485b;
    border-radius: 4px;
    min-height: 19px;
    padding: 6px 10px;
}
QPushButton {
    font-weight: 600;
}
QPushButton:hover, QComboBox:hover, QLineEdit:hover {
    background: #28394b;
    border-color: #5a748c;
}
QPushButton:focus, QComboBox:focus, QLineEdit:focus {
    border-color: #a9c7e2;
}
QPushButton:pressed {
    background: #17222e;
}
QPushButton#btnPause {
    min-width: 82px;
}
QPushButton#btnPause, QDialogButtonBox QPushButton:default {
    background: #ffd166;
    border-color: #ffd166;
    color: #222016;
}
QPushButton#btnPause:hover, QDialogButtonBox QPushButton:default:hover {
    background: #ffdf93;
}
QPushButton#btnPause:focus, QDialogButtonBox QPushButton:default:focus {
    border-color: #ffffff;
}
QPushButton#btnPause:checked {
    background: #2c3b47;
    border-color: #ffd166;
    color: #ffe6a6;
}
QPushButton:disabled {
    background: #192530;
    border-color: #2b3a49;
    color: #81909f;
}
QCheckBox {
    spacing: 7px;
    color: #c5d2de;
}
QComboBox {
    padding-right: 24px;
}
QComboBox QAbstractItemView {
    background: #202e3d;
    border: 1px solid #35485b;
    selection-background-color: #38536b;
    selection-color: #ffffff;
    outline: none;
}
QTabWidget::pane {
    background: #17222e;
    border: 0;
    border-top: 1px solid #35485b;
}
QTabBar::tab {
    background: #17222e;
    color: #aebdcb;
    border: 0;
    border-bottom: 2px solid transparent;
    padding: 8px 7px 7px;
}
QTabBar::tab:hover {
    color: #f4f7fa;
    background: #243242;
}
QTabBar::tab:selected {
    border-bottom-color: #ffd166;
    color: #f8e4af;
    font-weight: 600;
}
QTableWidget {
    background: #131d28;
    alternate-background-color: #1b2835;
    border: 1px solid #2b3a49;
    border-radius: 3px;
    selection-background-color: #38536b;
}
QTableWidget::item {
    padding-left: 5px;
    padding-right: 5px;
}
QHeaderView::section {
    background: #223242;
    color: #d7e2ec;
    border: 0;
    border-bottom: 1px solid #35485b;
    padding: 6px 4px;
    font-size: 12px;
    font-weight: 600;
}
QTextEdit, QTextBrowser {
    background: #131d28;
    border: 1px solid #2b3a49;
    border-radius: 4px;
    color: #d9e4ee;
    padding: 8px;
}
QSplitter::handle {
    background: #263645;
    width: 6px;
}
QSplitter::handle:hover {
    background: #57718a;
}
QStatusBar {
    background: #101821;
    color: #a5b4c3;
}
QStatusBar::item {
    border: 0;
}
QToolTip {
    background: #263645;
    color: #f4f7fa;
    border: 1px solid #5a748c;
    padding: 4px;
}
